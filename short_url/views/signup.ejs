<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signup</title>
  </head>

  <body>
    <h1>Signup</h1>

    <form method="POST" action="/user">
     <label for="name">Full Name:</label>
<input
  type="text"
  id="name"
  name="name"
  placeholder="Ex. Harendra Godara"
  autocomplete="name"
  required
/>

<br /><br />

<label for="email">Email:</label>
<input
  type="email"
  id="email"
  name="email"
  placeholder="Ex. example@gmail.com"
  autocomplete="email"
  required
/>

<br /><br />

<label for="password">Password:</label>
<input
  type="password"
  id="password"
  name="password"
  autocomplete="new-password"
  required
/>

<br /><br />

      <button type="submit">Signup</button>
    </form>
  </body>
</html>
